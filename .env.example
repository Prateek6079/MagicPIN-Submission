# Copy to .env (local) or set as environment variables on Render. Never commit .env.

# --- LLM (Groq free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
# Ordered by preference; each model has its own free-tier rate-limit bucket.
LLM_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
LLM_ENABLED=true

# --- /v1/metadata ---
BOT_VERSION=1.0.0
SUBMITTED_AT=2026-09-26T00:00:00Z

# --- tuning (defaults are fine) ---
TICK_BUDGET_SECONDS=8
REPLY_BUDGET_SECONDS=8
LLM_CALL_TIMEOUT=9
PRECOMPOSE=true
PERSIST_SNAPSHOTS=false
LOG_LEVEL=INFO
